COMPONENT ray_stopper = Arm()

AT (0,0,1e-6) RELATIVE arm_sample

EXTEND %{

  if (fabs(x) < 0.05 && fabs(y) < 0.05 && fabs(z) < 0.05) ABSORB;              

%} 


COMPONENT detector_inner = Monitor_nD( 
    yheight  = 2.0,
    radius   = 1*0.24,
    options  = "banana, multiple, theta limits=[0,180] bins=5, lambda limits=[4, 7] bins=100, time limits=[0,5] bins=100, y limits=[-1, 1] bins=100, incoming, list all neutrons",
    filename = "detector_inner",
    restore_neutron=1.0)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
%}

//------------------
// write chopper parameters into the h5 file
COMPONENT chopper_settings = ChopperSettingsNexus(
  chopperfile = chopperfile,
  filename    = "chopper_settings"
)
AT (0, 0, 0) ABSOLUTE
//------------------

/* The END token marks the instrument definition end */
END
